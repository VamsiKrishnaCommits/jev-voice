# Required for live conversations. Never commit populated credentials.
# Silence mode needs ElevenLabs + OpenAI; Jev mode also needs Typesafe.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
TYPESAFE_API_KEY=
# Optional
VOICE_LLM_MODEL=gpt-6-luna
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Demo default. Set eleven_flash_v2_5 to compare with the previous voice model.
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
# Optional hosted LiveKit v1 mode. Keep all secrets server-side.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
